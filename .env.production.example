# Required Twilio production credentials
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace_with_production_auth_token
TWILIO_PHONE=+1xxxxxxxxxx

# Dashboard login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_long_random_password

# Public URL from Railway/Render, without a trailing slash
PUBLIC_BASE_URL=https://your-app.example.com
VALIDATE_TWILIO_WEBHOOKS=true

# SQLite persistence path. Use a mounted volume path in production.
DB_PATH=/data/hours.db
REPORT_OUTPUT_DIR=/data/reports

# Optional monitoring
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# Scheduler times are UTC.
# 15 UTC is 10 AM CDT / 9 AM CST depending on daylight saving time.
WEEKLY_PROMPT_UTC_HOUR=15
MONTHLY_REPORT_UTC_HOUR=23
